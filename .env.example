# Required: Twelve Data API key (free tier works). Get one at https://twelvedata.com/pricing
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Optional: protect the /api/analysis endpoint with a bearer token.
# If set, requests must include: Authorization: Bearer <ACCESS_TOKEN>
ACCESS_TOKEN=

# Optional: override the refresh schedule (cron syntax). Default = every 15 minutes.
REFRESH_CRON=*/15 * * * *

# --- Email alerts for high-confidence signals (max 2 per rolling 24h) ---
# Where alerts get sent
EMAIL_TO=you@example.com
# "From" address shown on the email — defaults to SMTP_USER if left blank
EMAIL_FROM=

# SMTP credentials — works with Gmail (App Password), SendGrid, Mailgun,
# Postmark, Resend, or any other SMTP provider. See README for setup.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password

# Optional overrides for the alert gate (defaults: max 2/day, 3h cooldown)
SIGNAL_MAX_PER_DAY=2
SIGNAL_COOLDOWN_HOURS=3

# Railway sets PORT automatically — no need to set it yourself.
